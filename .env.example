# ════════════════════════════════════════════════════════════════════════════
#  Agriculture RAG Assistant — Environment Configuration
#  Copy this file to .env and fill in your values.
#  .env is gitignored. Never commit real secrets.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AgriRAG Assistant"
APP_ENV=development              # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── FastAPI server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                  # Set false in production

# ── Streamlit ─────────────────────────────────────────────────────────────────
STREAMLIT_API_BASE_URL=http://localhost:8000   # URL Streamlit uses to reach FastAPI

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=agri_knowledge
# Leave QDRANT_API_KEY blank when running local Docker Qdrant (no auth needed)
QDRANT_API_KEY=

# ── Embedding model ───────────────────────────────────────────────────────────
# HuggingFace model id used for generating document + query embeddings.
# Must match the model used when the collection was first built.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Language model ────────────────────────────────────────────────────────────
AGRIPARAM_MODEL_NAME="use agriparam model"
# Device: "cpu" | "cuda" | "mps"
AGRIPARAM_DEVICE=cpu
# Max new tokens for generation
AGRIPARAM_MAX_NEW_TOKENS=192
AGRIPARAM_TEMPERATURE=0.3
AGRIPARAM_TOP_P=0.9

# ── RAG pipeline ──────────────────────────────────────────────────────────────
# Number of documents to retrieve per query
RAG_TOP_K=5
# Minimum cosine similarity score for a document to be included
RAG_SCORE_THRESHOLD=0.35

# ── PDF ingestion ─────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Directory scanned by the ingest service for PDFs
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# ── HuggingFace cache (optional, avoids re-downloading models) ────────────────
HF_HOME=./data/.hf_cache
